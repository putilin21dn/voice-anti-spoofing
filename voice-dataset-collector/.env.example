# Скопируйте в .env и заполните сами. Файл .env не коммитится.
# Имена ниже соответствуют collector. В backend те же значения называются
# POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD.

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public

# Как в worker/backend: S3_HOST, S3_PORT, S3_SECURE, S3_BUCKET, ключи доступа.
# S3_ENDPOINT_URL необязателен. Если он задан, используется он.
# Если пуст, адрес собирается из S3_HOST / S3_PORT / S3_SECURE.
# Для AWS (host содержит amazonaws.com или host пуст) endpoint не задаётся,
# и boto3 использует стандартный AWS endpoint региона.
# Пустые ключи не подставляются: boto3 может взять IAM-роль или стандартную цепочку.

S3_ENDPOINT_URL=
S3_HOST=
# Пусто — стандартный порт схемы: 443 для https, 80 для http.
# 9000 нужен только для MinIO, опубликованного на этом порту.
S3_PORT=
S3_SECURE=false
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
