# Copy to .env and fill locally. .env is gitignored.
# Do not put real passwords, tokens, phone numbers, or object keys here.

# voice-dataset-collector / PostgreSQL (read-only use)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public

# Object storage. Leave the endpoint empty unless a non-AWS endpoint is required.
S3_ENDPOINT_URL=
S3_HOST=
S3_PORT=
S3_SECURE=false
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Optional path override for classical-anti-spoofing.
# CAS_CONFIG=classical-anti-spoofing/config/config.yaml
